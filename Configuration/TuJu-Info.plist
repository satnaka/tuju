<plist version="1.0">
<dict>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>TuJu account sign-in</string>
            <key>CFBundleURLSchemes</key>
            <array><string>$(TUJU_OIDC_CALLBACK_SCHEME)</string></array>
        </dict>
    </array>
    <key>TuJuOIDCIssuer</key>
    <string>$(TUJU_OIDC_ISSUER)</string>
    <key>TuJuOIDCClientID</key>
    <string>$(TUJU_OIDC_CLIENT_ID)</string>
    <key>TuJuOIDCRedirectURI</key>
    <string>$(TUJU_OIDC_CALLBACK_SCHEME):/oauth/callback</string>
